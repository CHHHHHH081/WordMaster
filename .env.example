# Local development (SQLite - leave empty for default)
# DATABASE_URL="file:../words.db"

# Production (PostgreSQL - set this on Vercel)
# Get a free PostgreSQL database from https://neon.tech or https://vercel.com/storage/postgres
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Secret (change this in production!)
JWT_SECRET="change-me-to-a-random-string"
